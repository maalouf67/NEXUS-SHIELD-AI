# Railway PostgreSQL image aligned with local Docker Compose (PostgreSQL 16).
FROM postgres:16-alpine

# Replace the base image's older gosu binary with the official signed 1.20
# release, which includes github.com/moby/sys/user v0.4.1 (CVE-2026-61801 fix).
ARG GOSU_VERSION=1.20
RUN set -eux; \
    apk add --no-cache ca-certificates dpkg gnupg wget; \
    dpkgArch="$(dpkg --print-architecture | awk -F- '{print $NF}')"; \
    wget -O /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/${GOSU_VERSION}/gosu-${dpkgArch}"; \
    wget -O /usr/local/bin/gosu.asc "https://github.com/tianon/gosu/releases/download/${GOSU_VERSION}/gosu-${dpkgArch}.asc"; \
    export GNUPGHOME="$(mktemp -d)"; \
    gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys B42F6819007F00F88E364FD4036A9C25BF357DD4; \
    gpg --batch --verify /usr/local/bin/gosu.asc /usr/local/bin/gosu; \
    gpgconf --kill all; \
    rm -rf "$GNUPGHOME" /usr/local/bin/gosu.asc; \
    apk del --no-network dpkg gnupg wget; \
    chmod +x /usr/local/bin/gosu; \
    gosu --version; \
    gosu nobody true

COPY database/init/ /docker-entrypoint-initdb.d/

# Run non-root by default (Trivy DS-0002).
# Railway volumes are mounted root-owned; on Railway, set RAILWAY_RUN_UID=0
# so the official entrypoint can prepare PGDATA and then drop to postgres.
USER postgres
