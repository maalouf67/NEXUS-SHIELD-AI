# Build the pinned gosu 1.20 source using a patched Go toolchain.
FROM golang:1.27.3-alpine AS gosu-build
WORKDIR /src/gosu
COPY database/gosu-src/ ./
RUN go build -trimpath -ldflags="-s -w" -o /out/gosu .

# Railway PostgreSQL image aligned with local Docker Compose (PostgreSQL 16).
FROM postgres:16-alpine
# Override the base image's older gosu binary with the source-built patched version.
COPY --from=gosu-build /out/gosu /usr/local/bin/gosu
RUN set -eux; \
    chmod 0755 /usr/local/bin/gosu; \
    gosu --version; \
    gosu nobody true

COPY database/init/ /docker-entrypoint-initdb.d/

# Run non-root by default (Trivy DS-0002).
# Railway volumes are mounted root-owned; on Railway, set RAILWAY_RUN_UID=0
# so the official entrypoint can prepare PGDATA and then drop to postgres.
USER postgres
