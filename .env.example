APP_NAME="NEXUS_SHIELD_AI"
NODE_ENV="development"
PORT=4000
HOST="127.0.0.1"
# Number of trusted reverse-proxy hops; keep 0 for direct/local traffic.
TRUST_PROXY_HOPS=0
# Optional dedicated HMAC key (32+ chars). If empty, SESSION_SECRET is used.
RATE_LIMIT_HASH_SECRET=""

API_BASE_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:4000"
AI_BASE_URL="http://127.0.0.1:8001"

# Local Docker PostgreSQL settings. Set a strong password before starting Compose.
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="nexus_shield_ai"
POSTGRES_USER="nexus_user"
POSTGRES_PASSWORD=""

# Must match POSTGRES_PASSWORD. URL-encode reserved characters in the password.
DATABASE_URL="postgresql://nexus_user:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/nexus_shield_ai"
# false for the local Docker database; true for the remote TLS database configuration.
DATABASE_SSL="false"
# Optional custom CA file path for a remote PostgreSQL provider.
DATABASE_SSL_CA_PATH=""

# Generate unique values of at least 32 characters. Never reuse production secrets.
JWT_SECRET=""
SESSION_SECRET=""

# One-time initial admin provisioning only. Remove the password after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Shared server-side credential for protected API, Next.js BFF and internal AI scanner calls.
# Configure the same strong value only in trusted server environments (API, Next.js server, AI service).
# Never use a NEXT_PUBLIC_ prefix or expose this value to browser JavaScript.
NEXUS_SERVICE_API_TOKEN=""

# Private quarantine directory. Docker Compose configures this inside the AI container.
NEXUS_QUARANTINE_DIR=""
NEXUS_MAX_UPLOAD_BYTES="104857600"
# Private ClamAV daemon endpoint. Use clamav.railway.internal on Railway.
CLAMD_HOST="clamav"
CLAMD_PORT="3310"

# Phone reputation provider keys belong ONLY on the Express API server.
# Never use NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes and never commit real credentials.
IPQS_API_KEY=""
IPQS_PHONE_STRICTNESS="0"
SEON_API_KEY=""
# Select the endpoint assigned to your SEON account/TPE. Default in code is the global endpoint.
# Middle East TPE: https://api.me-central-1-main.seon.io/SeonRestService/phone-api/v2
SEON_PHONE_API_URL="https://api.seon.io/SeonRestService/phone-api/v2"

# AbuseIPDB API v2. The default daily cap reserves headroom below the 1,000/day Standard quota.
ABUSEIPDB_API_KEY=""
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_DAILY_LIMIT=850

# Optional OpenTelemetry OTLP/HTTP trace export; disabled unless an internal collector is configured.
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="nexus-shield-api"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"

# Optional dedicated bearer secret for trusted upstream event sources. Keep on the API server only.
NEXUS_EVENT_INGESTION_TOKEN=""

# Browser CORS is disabled by default; the Next.js same-origin BFF talks to the API server.
# Add exact trusted browser origins only if direct cross-origin API access is deliberately enabled.
ALLOWED_ORIGINS=""
LOG_LEVEL="info"
AI_MODEL="gpt-4o-mini"

# MobSF reverse-engineering lab (only used with docker-compose.reverse-engineering.yml).
# Use long unique values and keep the API key in a separate chmod-600 file.
MOBSF_USERNAME="nexus-analyst"
MOBSF_PASSWORD=""
MOBSF_API_KEY_FILE="./.secrets/mobsf-api-key"

# OpenAI server-side configuration. Keep the key out of browser-visible files.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
