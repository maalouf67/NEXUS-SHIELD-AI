# Copy to .env.production on the VPS. Never commit the real .env.production file.
# Use a DNS A record pointing NEXUS_DOMAIN to the VPS before starting Caddy.
NEXUS_DOMAIN=your-domain.example
NEXUS_IMAGE_TAG=latest

POSTGRES_DB=nexus
POSTGRES_USER=nexus
# Use a long URL-safe alphanumeric password so DATABASE_URL needs no percent-encoding.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql://nexus:REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD@postgres:5432/nexus

# Each secret must be generated independently and contain at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
NEXUS_SERVICE_API_TOKEN=REPLACE_WITH_A_RANDOM_SERVICE_TOKEN_OF_AT_LEAST_32_CHARACTERS
RATE_LIMIT_HASH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXUS_MAX_UPLOAD_BYTES=104857600
NEXUS_EVENT_INGESTION_TOKEN=

IPQS_API_KEY=
IPQS_PHONE_STRICTNESS=0
SEON_API_KEY=
SEON_PHONE_API_URL=
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_DAILY_LIMIT=850
